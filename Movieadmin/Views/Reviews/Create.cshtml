
@model Movieadmin.Models.MovieReview

@{
    ViewData["Title"] = "Write a Review";
}

<h2>Write a Review</h2>

<h4>@ViewBag.MovieTitle</h4>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <input type="hidden" name="movieId" value="@ViewBag.MovieId" />

            <div class="form-group mb-3">
                <label asp-for="Rating" class="control-label">Rating (0–5)</label>
                <input asp-for="Rating" type="number"
                       min="0" max="5" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ReviewText" class="control-label">Your Review</label>
                <textarea asp-for="ReviewText" class="form-control"
                          rows="5" maxlength="1000"></textarea>
                <span asp-validation-for="ReviewText" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit Review</button>
            <a asp-controller="Movies" asp-action="Details"
               asp-route-id="@ViewBag.MovieId" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
