@model Movieadmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Movie Details</h1>
        <p class="text-muted">Explore the movie information</p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">@Model.Title</h4>
        </div>

        <div class="card-body">

            <div class="mb-4">
                <h6 class="text-muted">Synopsis</h6>
                <p class="fs-5">@Model.Synopsis</p>
            </div>

            <hr />

            <div class="row g-4">

                <div class="col-md-6">
                    <h6 class="text-muted">Genre</h6>
                    <p class="fw-bold">@Model.Genre</p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Rating</h6>
                    <span class="badge bg-secondary fs-6">
                        @Model.Rating
                    </span>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Runtime</h6>
                    <p class="fw-bold">
                        @Model.RuntimeHours hours
                        @Model.RuntimeMinutes minutes
                    </p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Release Date</h6>
                    <p class="fw-bold">
                        @Model.ReleaseDate.ToString("MMMM dd, yyyy")
                    </p>
                </div>

            </div>

            <hr />

            <div class="d-flex gap-2 mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit Movie
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Library
                </a>

            </div>

        </div>
    </div>

</div>
