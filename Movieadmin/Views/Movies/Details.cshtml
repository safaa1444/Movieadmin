@model Movieadmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="fw-bold">Movie Details</h1>
        <p class="text-muted">Explore the movie information</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">@Model.Title</h4>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Url.Action("Image", "Movies", new { id = Model.Id })"
                         alt="@Model.Title poster"
                         class="img-fluid rounded shadow"
                         style="max-height:450px;object-fit:contain;" />
                </div>
            }

            <div class="mb-4">
                <h6 class="text-muted">Synopsis</h6>
                <p class="fs-5">@Model.Synopsis</p>
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="text-muted">Genre</h6>
                    <p class="fw-bold">@Model.Genre?.Title</p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Audience Rating</h6>
                    <span class="badge bg-secondary fs-6">
                        @Model.AudienceRating?.Title
                    </span>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Runtime</h6>
                    <p class="fw-bold">
                        @Model.RuntimeHours hours
                        @Model.RuntimeMinutes minutes
                    </p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Release Date</h6>
                    <p class="fw-bold">
                        @Model.ReleaseDate.ToString("MMMM dd, yyyy")
                    </p>
                </div>
            </div>

            <hr />

            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">Edit Movie</a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">Back to Library</a>
            </div>
        </div>
    </div>
</div>

<hr />

<h3>Movie Reviews</h3>

@if (Model.MovieReviews != null && Model.MovieReviews.Any())
{
    <p>
        Total Reviews: @Model.MovieReviews.Count
    </p>

    @foreach (var review in Model.MovieReviews)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5>Rating: @review.Rating / 5</h5>

                <p>@review.ReviewText</p>

                <small class="text-muted">
                    @review.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                </small>
            </div>
        </div>
    }
}
else
{
    <p>No published reviews yet.</p>
}

@if (User.IsInRole("critic"))
{
    <a asp-controller="Reviews"
       asp-action="Create"
       asp-route-movieId="@Model.Id"
       class="btn btn-primary">
        Write a Review
    </a>

    <a asp-controller="Reviews"
       asp-action="MyReviews"
       class="btn btn-secondary">
        My Reviews
    </a>
}