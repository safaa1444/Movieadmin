@model IEnumerable<Movieadmin.Models.Movie>

@{
    ViewData["Title"] = "Movie Library";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Movie Library</h1>
            <p class="text-muted">Manage your movie collection</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add New Movie
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">All Movies</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       style="min-width: 900px;">

                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th style="min-width: 250px;">Synopsis</th>
                            <th>Genre</th>
                            <th>Rating</th>
                            <th>Runtime</th>
                            <th>Release Date</th>
                            <th style="min-width: 180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @item.Title
                                    </td>

                                    <td>
                                        @item.Synopsis
                                    </td>

                                    <td>
                                        @item.Genre
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @item.Rating
                                        </span>
                                    </td>

                                    <td>
                                        @item.RuntimeHours h @item.RuntimeMinutes min
                                    </td>

                                    <td>
                                        @item.ReleaseDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <h5 class="text-muted">No movies yet</h5>

                                    <p class="text-muted">
                                        Start building your movie collection!
                                    </p>

                                    <a asp-action="Create" class="btn btn-primary">
                                        + Add Your First Movie
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>