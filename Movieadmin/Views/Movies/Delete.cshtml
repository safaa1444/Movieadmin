@model Movieadmin.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Delete Movie</h1>
        <p class="text-muted">Review the movie information before deleting</p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Confirm Deletion</h5>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this movie?
            </div>

            <h3 class="fw-bold mb-4">@Model.Title</h3>

            <div class="mb-3">
                <h6 class="text-muted">Synopsis</h6>
                <p>@Model.Synopsis</p>
            </div>

            <hr />

            <div class="row g-3">

                <div class="col-md-6">
                    <h6 class="text-muted">Genre</h6>
                    <p class="fw-bold">@Model.Genre</p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Rating</h6>
                    <p class="fw-bold">@Model.Rating</p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Runtime</h6>
                    <p class="fw-bold">
                        @Model.RuntimeHours hours
                        @Model.RuntimeMinutes minutes
                    </p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted">Release Date</h6>
                    <p class="fw-bold">
                        @Model.ReleaseDate.ToString("MMMM dd, yyyy")
                    </p>
                </div>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 mt-3">

                    <button type="submit" class="btn btn-danger">
                        Delete Movie
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>